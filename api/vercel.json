{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "routes/**",
          "services/**",
          "middleware/**"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/cleanup-sessions",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/health-report",
      "schedule": "0 13 * * 1"
    }
  ]
}
